[Unit]
Description=Periodic trigger for network mode detection
After=network-online.target
Wants=network-online.target

[Service]
# systemd .timer units (OnBootSec/OnUnitActiveSec) can get stuck at "n/a" and
# never fire again after a large CLOCK_REALTIME jump. This Pi has no RTC, so
# it boots with a stale clock and jumps forward once NTP finally syncs -
# reliably wedging a timer unit. A sleep-loop only relies on the monotonic
# clock, so it survives that jump.
Type=simple
ExecStart=/bin/bash -c 'sleep 20; while true; do systemctl start network-mode-check.service; sleep 30; done'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
